# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# 本地临时目录（安装缓存、构建产物、调试脚本）
/.tmp/
/.npm-cache/
/.devbuild/
/.devbuild2/
/.devrun2/
/.build1/
/.next-build/

# 词库生成用的源数据（66MB，npm run packs 前先用 README 里的命令重新下载）
/.ecdict/

# 词包是构建产物，但需要随站点发布，所以 public/packs/ 要提交

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
